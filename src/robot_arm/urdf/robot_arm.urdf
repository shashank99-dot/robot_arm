<?xml version="1.0"?>

<robot name = "robot_arm">

    <link name="world"/>

    <link name ="base_link">

        <visual>
            <origin xyz = "-0.05 -0.05 0.06" rpy = "-1.55 0 0"/>
            <geometry>
                <mesh filename = "package://robot_arm/meshes/BaseHousing.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz = "-0.05 -0.05 0.06" rpy = "-1.55 0 0"/>
            <geometry>
                <mesh filename = "package://robot_arm/meshes/BaseHousing.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>

        <inertial>

            <origin xyz="-0.000210 0.000599 0.037967" rpy="-1.55 0 0"/>
            <mass value="0.07742"/>
            <inertia ixx="0.000131651" ixy="0" ixz="0"
                     iyy="0.000205327" iyz="0"
                     izz="0.000132801"/>

        </inertial>
        
    </link>

    <joint name ="world_to_base" type="fixed">

        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        
    </joint>

    <link name="rotation_link">
        <visual>
            <origin xyz="-0.05 -0.052 0.162" rpy="-1.55 0 0"/>
            <geometry>
                <mesh filename="package://robot_arm/meshes/rotation.STL"
                    scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="-0.05 -0.052 0.162" rpy="-1.55 0 0"/>
            <geometry>
                <mesh filename="package://robot_arm/meshes/rotation.STL"
                    scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.000210000 -0.000130265 0.105326367"
                    rpy="-1.55 0 0"/>
            <mass value="0.12876"/>
            <inertia ixx="0.000261618" ixy="0" ixz="0"
                    iyy="0.000303460" iyz="0"
                    izz="0.000321808"/>
        </inertial>
    </link>

    <joint name="joint_1" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link = "base_link"/>
        <child link = "rotation_link"/>
        <axis xyz = "0 0 1"/>
        <limit effort="5.0" velocity="1.0"/>
        <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <link name="biceps_link">
        <visual>
            <origin xyz = "-0.023 0.29 -0.039" rpy="0 0 -1.59"/>
            <geometry>
                <mesh filename="package://robot_arm/meshes/biceps.STL"
                    scale = "0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz = "-0.023 0.29 -0.039" rpy="0 0 -1.59"/>
            <geometry>
                <mesh filename="package://robot_arm/meshes/biceps.STL"
                    scale = "0.001 0.001 0.001"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.003339057 0.102743068 0.001920000"
                    rpy="0 0 -1.59"/>
            <mass value="0.27575"/>
            <inertia ixx="0.000255695" ixy="0" ixz="0"
                    iyy="0.001998483" iyz="0"
                    izz="0.001912020"/>
        </inertial>
    </link>

    <joint name="joint_2" type ="revolute">
        <origin xyz= "0 0 0.12" rpy = "0 0 0"/>
        <parent link = "rotation_link"/>
        <child link = "biceps_link"/>
        <axis xyz = "1 0 0"/>
        <limit lower = "0" upper = "3.141593" effort = "5.0" velocity = "1.0"/>
        <dynamics damping="0.1" friction="0.0"/>

    </joint>

    <link name = "vorarm_link">
        <visual>
            <origin xyz = "-0.035 0.25 0.04" rpy = "1.566 3.15 1.566"/>
            <geometry>
                <mesh filename="package://robot_arm/meshes/vorarm.STL"
                    scale = "0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz = "-0.035 0.25 0.04" rpy = "1.566 3.15 1.566"/>
            <geometry>
                <mesh filename="package://robot_arm/meshes/vorarm.STL"
                    scale = "0.001 0.001 0.001"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.008400369 0.131259611 0.001075051"
                    rpy="1.566 3.15 1.566"/>
            <mass value="0.25673"/>
            <inertia ixx="0.000245497" ixy="0" ixz="0"
                    iyy="0.001580958" iyz="0"
                    izz="0.001649582"/>
        </inertial>
        
    </link>

    <joint name="joint_3" type ="revolute">
        <origin xyz= "0 0.25 0" rpy = "0 0 0"/>
        <parent link = "biceps_link"/>
        <child link = "vorarm_link"/>
        <axis xyz = "1 0 0"/>
        <limit lower = "-2.2" upper = "2.2" effort = "5.0" velocity = "1.0"/>
        <dynamics damping="0.1" friction="0.0"/>

    </joint>

</robot>
